# WhisperX ASR API Service Configuration

# Hugging Face Token (REQUIRED for speaker diarization)
# Get your token from https://huggingface.co/settings/tokens
# Accept user agreements for ALL THREE models:
# - https://huggingface.co/pyannote/speaker-diarization-community-1
# - https://huggingface.co/pyannote/speaker-diarization-3.1
# - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=your_huggingface_token_here

# Device Configuration
# Options: cuda, cpu
DEVICE=cuda

# Compute Type
# Options: float16 (GPU), float32 (CPU), int8 (CPU, lower quality but faster)
COMPUTE_TYPE=float16

# Device for the Wav2Vec2 alignment stage (defaults to DEVICE). Set to cpu to
# keep alignment off the GPU and reduce VRAM on small cards, at the cost of
# slower word timestamps.
# ALIGN_DEVICE=cpu

# Batch Size (adjust based on your GPU memory)
# Larger = faster but more memory
# Default is device-aware when unset: 16 on cuda, 2 on cpu.
# Recommended: 16 for 8GB VRAM, 32 for 16GB+ VRAM, 1-2 on cpu.
BATCH_SIZE=16

# Cache Directory (inside container)
# Used for WhisperX models and alignment models
CACHE_DIR=/.cache

# Hugging Face Cache Directory
# Used for pyannote diarization models - set to same as CACHE_DIR for unified caching
# This enables offline use after models are downloaded once
# Set automatically in docker-compose.yml to match CACHE_DIR
# HF_HOME=/.cache

# Offline Mode (OPTIONAL)
# Set to 1 to run in offline mode (no network requests to Hugging Face)
# Requires all models to be cached first - run once with internet access
# See README.md "Offline Use" section for details
# HF_HUB_OFFLINE=1

# Model Preloading (OPTIONAL)
# Load a model at startup to reduce first-request latency. Leave it empty or
# comment it out to load models only when a request needs them (for example
# on a GPU shared with other services). Any name /v1/models lists works, e.g.
# large-v3, turbo, distil-large-v3.5, medium, small.
PRELOAD_MODEL=large-v3

# Default Model (OPTIONAL)
# Model used when a request does not name one. If unset, PRELOAD_MODEL is
# used; if that is also empty, large-v3. An empty PRELOAD_MODEL therefore
# disables preloading without leaving requests without a model.
# DEFAULT_MODEL=large-v3

# Model that the OpenAI alias "whisper-1" maps to (OPTIONAL, default:
# the default model above).
# OPENAI_WHISPER1_MODEL=large-v3

# Restrict which models clients may request (OPTIONAL, comma-separated).
# Unset allows every model. The default model is always allowed.
# ALLOWED_MODELS=large-v3,turbo,distil-large-v3.5

# Maximum Whisper models kept in memory at once (OPTIONAL, 0 = no limit).
# Loading another model unloads the least recently used idle one first.
# MAX_LOADED_MODELS=2

# Maximum File Size (OPTIONAL)
# Maximum audio file size in MB to prevent out-of-memory errors
# Large files can cause VRAM exhaustion on the GPU
# Default: 1000MB (1GB)
# Adjust based on your GPU memory (lower for 8-16GB GPUs)
MAX_FILE_SIZE_MB=1000

# ---------------------------------------------------------------------------
# Security (OPTIONAL, all off by default)
# ---------------------------------------------------------------------------
# API key required on protected paths (/asr, /v1/audio/*, /metrics,
# /queue-metrics). Unset disables authentication (backward compatible).
# Accepted via "Authorization: Bearer <key>" or "X-API-Key".
# API_KEY=change-me
#
# Comma-separated list of accepted keys, for rotation/revocation without
# downtime. API_KEY (if set) is merged into this list.
# API_KEYS=key1,key2
#
# Per-IP rate limiting on transcription endpoints. 0 disables (default).
# RATE_LIMIT_REQUESTS=0
# Sliding window in seconds for the rate limiter above.
# RATE_LIMIT_WINDOW_SECONDS=60
#
# Comma-separated allowlist of browser origins for CORS. Empty disables CORS
# (no CORS headers emitted). Credentials are not allowed.
# ALLOWED_ORIGINS=http://localhost:3000
#
# Maximum length (characters) of initial_prompt / hotwords / prompt inputs.
# Oversized values return HTTP 400.
# MAX_PROMPT_CHARS=4096
#
# Allow clients to load Whisper models from local filesystem paths.
# Default false: only canonical names, aliases and Hugging Face ids (org/repo)
# are accepted, preventing path traversal / arbitrary local model loading.
# ALLOW_LOCAL_MODEL_PATHS=false
#
# Expose interactive docs and the OpenAPI schema. Set false to hide them in
# hardened deployments.
# ENABLE_DOCS=true
#
# Trust X-Forwarded-* headers (set true behind a reverse proxy). Affects
# client IP for rate limiting and HSTS activation.
# TRUST_PROXY=false
# ---------------------------------------------------------------------------
# Idle Model Eviction (OPTIONAL, new in v0.3.2)
# ---------------------------------------------------------------------------
# Unload Whisper models from memory after this many seconds of inactivity.
# The next request that needs the model will reload it transparently.
# Default 0 = disabled (preserves pre-v0.3.2 behaviour).
# Useful when you serve multiple models in rotation and want to reclaim VRAM.
# Example, unload after one hour idle:
# MODEL_KEEP_ALIVE_SECONDS=3600

# Sweep cadence for the eviction daemon (floor 30 seconds).
# MODEL_EVICTION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Diarization Hyperparameter Tuning (OPTIONAL)
# ---------------------------------------------------------------------------
# Tune the pyannote community-1 pipeline when speakers get merged or short
# turns get missed. All unset by default = the model's published defaults
# (output unchanged unless you opt in). The pipeline's full default parameter
# schema is logged at startup, so you can see the exact keys for your version.
#
# Main lever for merged/missed speakers. community-1 default is 0.6. Lower it
# (e.g. 0.5) to split similar/merged voices more aggressively; raise it for
# fewer speakers. Useful range ~0.4-0.8. (In testing, 0.6 -> 0.5 recovered a
# third speaker that the default merged into one label.)
# DIARIZE_CLUSTERING_THRESHOLD=0.5
#
# Non-speech gaps shorter than this (seconds) are filled, MERGING the turns on
# either side. community-1 default is 0.0. Raise it (e.g. 0.1-0.5) to suppress
# over-segmentation. It does NOT recover rapid turns (the default is already
# 0.0); use the clustering threshold above for that.
# DIARIZE_MIN_DURATION_OFF=0.2
#
# Escape hatch: a JSON object deep-merged into the pipeline's instantiated
# parameters, for any key the two vars above don't cover. The community-1
# schema also exposes clustering.Fa (false-alarm weight, default 0.07) and
# clustering.Fb (missed-detection weight, default 0.8). Use the schema printed
# in the startup logs to confirm valid keys.
# DIARIZE_PARAM_OVERRIDES={"clustering": {"Fb": 1.0}}
#
# Assign the nearest speaker to words/segments that fall outside every
# diarization turn, instead of leaving them with no speaker label. Fixes
# "orphan" segments (e.g. a closing line that shows up untagged). Default
# false. Trade-off: a long silence may occasionally be tagged with a speaker.
# DIARIZE_FILL_NEAREST=false

# ---------------------------------------------------------------------------
# ASR Backend (experimental)
# ---------------------------------------------------------------------------
# whisper (default) = faster-whisper/CTranslate2, ~10x faster than qwen3.
# qwen3 = Qwen3-ASR transcription + Qwen3 forced aligner. The aligner is
# language-agnostic across its supported set, which handles code-switched
# audio (e.g. Chinese/English) that per-language Wav2Vec2 alignment cannot.
# hotwords/initial_prompt become free-text context biasing. Ignores the
# requested Whisper model name; task=translate falls back to whisper.
# Requires transformers >= 5.13 (included in the image). Weights (~4.6 GB)
# download to the cache volume on first use.
# ASR_BACKEND=qwen3
#
# Override the Qwen model checkpoints (defaults shown; use the -hf variants).
# QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
# QWEN3_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B-hf
#
# Audio chunk length in seconds (default 90). The encoder handles up to
# ~300 s, but shorter chunks are less prone to truncation and repetition
# loops on difficult audio.
# QWEN3_CHUNK_SECONDS=90

# ---------------------------------------------------------------------------
# External ASR Backend (experimental)
# ---------------------------------------------------------------------------
# ASR_BACKEND=external outsources ONLY the transcription stage to an
# OpenAI-compatible API; alignment, diarization, and speaker embeddings
# keep running locally. NOTE: your audio is uploaded to the provider.
#
# EXTERNAL_ASR_MODE=transcriptions (default) posts to
# {base}/audio/transcriptions (whisper-1, Groq, self-hosted Whisper
# servers). Providers that return timestamped segments use the local
# Wav2Vec2 alignment; text-only responses are word-timestamped by the
# Qwen forced aligner instead (~1.2 GB, downloads on first use).
# EXTERNAL_ASR_MODE=chat posts base64 audio to {base}/chat/completions
# (OpenRouter audio models such as Voxtral, vLLM multimodal servers);
# these are text-only and always use the Qwen forced aligner.
# ASR_BACKEND=external
# EXTERNAL_ASR_BASE_URL=https://api.openai.com/v1
# EXTERNAL_ASR_API_KEY=sk-...
# EXTERNAL_ASR_MODEL=whisper-1
# EXTERNAL_ASR_MODE=transcriptions
#
# Force the Qwen forced aligner even when the provider returns timestamped
# segments (useful for code-switched audio or languages without a good
# Wav2Vec2 model). "auto" (default) picks by response shape.
# EXTERNAL_ASR_ALIGNER=qwen

# ---------------------------------------------------------------------------
# Speaker-Turn Segmentation
# ---------------------------------------------------------------------------
# Rebuild segments at speaker-change boundaries after diarization, so rapid
# turns are not merged into a single speaker's segment. Always on for the
# qwen3 backend. Opt-in for the whisper backend (default false), because it
# changes the segment shape compared to previous releases.
# RESEGMENT_BY_SPEAKER=true
#
# Standing vocabulary/context biasing text prepended to every request's
# context (same mechanism as per-request hotwords). Note: this cannot fix
# mixed-language handling. For code-switched audio a per-request language is
# required; without one the model picks the dominant language per chunk and
# translates the rest into it.
# QWEN3_DEFAULT_CONTEXT=Discussion about Speakr, WhisperX, and CTranslate2.

# ---------------------------------------------------------------------------
# Serve Mode
# ---------------------------------------------------------------------------
# simple = uvicorn with async GPU queue (default, backward compatible)
# ray    = Ray Serve with cross-request batching and stage-level parallelism
SERVE_MODE=simple

# GPU concurrency for simple mode (number of concurrent GPU pipeline runs)
# Default: 1 (safe for single-GPU setups)
# GPU_CONCURRENCY=1

# Pipeline strategy (only used when SERVE_MODE=ray)
#   replicate = full pipeline on each GPU (default, best for multi-GPU throughput)
#   split     = separate deployments per stage (for independent stage scaling)
# PIPELINE_STRATEGY=replicate

# ---------------------------------------------------------------------------
# Ray Serve Configuration (only used when SERVE_MODE=ray)
# ---------------------------------------------------------------------------
# Ray dashboard. Off the network by default; set RAY_DASHBOARD_HOST=0.0.0.0
# to open it at http://localhost:8265 on the Docker host (published on
# 127.0.0.1 only; from another machine, use an SSH tunnel). See README.
# RAY_DASHBOARD_HOST=127.0.0.1
# RAY_DASHBOARD_PORT=8265

# Cross-request batch sizes per pipeline stage
# Tune based on GPU VRAM -- smaller values use less memory
# WHISPER_BATCH_SIZE=4
# ALIGN_BATCH_SIZE=8
# DIARIZE_BATCH_SIZE=2

# Seconds to wait collecting a batch before processing what's available
# BATCH_WAIT_TIMEOUT=0.1

# Fractional GPU allocation per stage (should sum to ~1.0 per GPU)
# WHISPER_GPU_FRACTION=0.5
# ALIGN_GPU_FRACTION=0.3
# DIARIZE_GPU_FRACTION=0.2

# Number of replicas per stage (default for all stages).
# Set to the number of GPUs to place one full pipeline per device.
# NUM_GPU_REPLICAS=1
#
# Per-stage overrides (fall back to NUM_GPU_REPLICAS when unset):
# WHISPER_NUM_REPLICAS=2
# ALIGN_NUM_REPLICAS=1
# DIARIZE_NUM_REPLICAS=1
#
# Example configurations:
#
#   Replicate (4 GPUs, full pipeline on each):
#     NUM_GPU_REPLICAS=4
#     (fractions stay at 0.5/0.3/0.2 -- Ray packs one set per GPU)
#
#   Split (3 GPUs, each stage on its own GPU):
#     WHISPER_GPU_FRACTION=1.0
#     ALIGN_GPU_FRACTION=1.0
#     DIARIZE_GPU_FRACTION=1.0
#
#   Hybrid (4 GPUs, 2 Whisper + 1 Align + 1 Diarize):
#     WHISPER_NUM_REPLICAS=2  WHISPER_GPU_FRACTION=1.0
#     ALIGN_NUM_REPLICAS=1    ALIGN_GPU_FRACTION=1.0
#     DIARIZE_NUM_REPLICAS=1  DIARIZE_GPU_FRACTION=1.0
